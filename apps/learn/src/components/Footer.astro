---
// Lesson footer: quiz, "mark complete" and course progress, then Starlight's footer.
import Default from '@astrojs/starlight/components/Footer.astro';
import { lessonIds, readCourses } from '../lib/courses';
import { gameConfig } from '../lib/game';

const entry = Astro.locals.starlightRoute.entry;
const id = entry.id;
const parts = id.split('/');
const courses = readCourses();
const isLesson = parts.length === 3;
const isOverview = parts.length === 1 && courses.some((c) => c.slug === id);
const course = parts[0];
const lessons = isLesson || isOverview ? await lessonIds(course) : [];
const quiz = (entry.data as any).quiz as { question: string; options: string[]; answer: number; explanation?: string }[] | undefined;
const lab = (entry.data as any).lab as string | undefined;
const reward = gameConfig.rewards;
---
{isLesson && (
  <section class="lesson-end" data-lesson={id}>
    {lab && <p class="lab"><a href={lab} target="_blank" rel="noopener">🧪 Try this lesson in a browser lab ↗</a></p>}
    {quiz && quiz.length > 0 && (
      <form class="quiz" data-quiz={id}>
        <h2>Check your understanding</h2>
        {quiz.map((q, qi) => (
          <fieldset class="quiz-q" data-answer={q.answer}>
            <legend>{qi + 1}. {q.question}</legend>
            {q.options.map((o, oi) => (
              <label><input type="radio" name={`q${qi}`} value={oi} required /> <span>{o}</span></label>
            ))}
            {q.explanation && <p class="quiz-why" hidden>{q.explanation}</p>}
          </fieldset>
        ))}
        <button type="submit" class="learn-btn">Check answers <span class="g-only">(+{reward.quiz} XP)</span></button>
        <p class="quiz-result" aria-live="polite"></p>
      </form>
    )}
    <div class="complete-row">
      <button type="button" class="learn-btn learn-btn--ghost" data-complete={id}>Mark lesson complete <span class="g-only">(+{reward.lesson} XP)</span></button>
      <span class="course-mini" data-course-progress={course} data-lessons={JSON.stringify(lessons)}></span>
    </div>
  </section>
)}
{isOverview && (
  <section class="course-progress" data-course-progress={course} data-lessons={JSON.stringify(lessons)} data-full>
    <h2>Your progress</h2>
    <div class="cp-bar"><span></span></div>
    <p class="cp-text">Loading…</p>
    <a class="learn-btn" data-cp-next href={lessons[0] ? `/${lessons[0]}/` : '#'}>Start the course →</a>
  </section>
)}
<Default />
