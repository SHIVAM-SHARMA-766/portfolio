---
import Head from '../../components/Head.astro';
import Switcher from '../../components/Switcher.astro';
import GameBoot from '../../components/GameBoot.astro';
import AchievementsDialog from '@portfolio/game/AchievementsDialog.astro';
import AccountDialogs from '@portfolio/game/AccountDialogs.astro';
import AccountChip from '../../components/AccountChip.astro';
import ThemeLock from '../../components/ThemeLock.astro';
import Shell from './Shell.astro';
import Logo from '../../components/Logo.astro';
import FooterColumns from '../../components/FooterColumns.astro';
import { site, pageUrl } from '../../lib/content';
import type { Page } from '../../lib/schema';
import './terminal.css';

interface Props { theme: string; title: string; description?: string; slug: string; nav: Page[]; pageIdent: string | null; current?: string; image?: string | null }
const { theme, title, description, slug, nav, pageIdent, current = slug, image } = Astro.props;
const cwd = slug ? `~/${slug}` : '~';
---
<html lang="en" data-theme="terminal">
  <Head theme={theme} title={title} description={description} slug={slug} pageIdent={pageIdent} image={image}
    fonts="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&display=swap" />
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="t-window">
      <header class="t-bar">
        <span class="t-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <a class="t-logo" href={pageUrl(theme, '')} aria-label="Home"><Logo size={22} /></a>
        <span class="t-title">{site.shortName}@portfolio: {cwd}</span>
        <button type="button" class="t-hud g-only" data-open-ach aria-label="Open achievements">
          <span>LVL <b data-game-level>1</b></span>
          <span class="t-hud-name" data-game-level-name>Visitor</span>
          <span class="t-meter" data-game-progress role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100"></span>
          <span><b data-game-xp>0</b> XP</span>
        </button>
        <AccountChip />
      </header>
      <div class="t-body">
        <nav class="t-nav" aria-label="Pages">
          <p class="t-dim">$ ls ~</p>
          <ul>
            {nav.map((p) => (
              <li><a href={pageUrl(theme, p.slug)} aria-current={p.slug === current ? 'page' : undefined}>{p.slug || 'home'}/</a></li>
            ))}
            {site.learnUrl && <li><a href={site.learnUrl}>learn/ ↗</a></li>}
          </ul>
          <details class="t-prefs" open>
            <summary>$ theme &amp; palette</summary>
            <Switcher theme={theme} slug={slug} />
            <button type="button" class="t-btn g-only" data-open-ach>achievements [<span data-game-ach-count>0/0</span>]</button>
          </details>
          <script is:inline>
            // Phones: start folded so the page content comes first
            if (matchMedia('(max-width: 760px)').matches) document.querySelectorAll('.t-prefs').forEach((d) => d.removeAttribute('open'));
          </script>
        </nav>
        <main id="main" class="t-main">
          <slot />
          <div data-game-end aria-hidden="true"></div>
          <Shell theme={theme} nav={nav} />
        </main>
      </div>
      <footer class="t-footer">
        <div class="t-footer-top">
          <div class="t-footer-brand">
            <p class="t-dim">$ cat ~/.signature</p>
            <p class="t-footer-name"><Logo size={22} /> {site.name}</p>
            <p>{site.tagline}</p>
            {site.email && <a class="t-link-btn" href={`mailto:${site.email}`}>[ ./say-hello.sh ]</a>}
          </div>
          <FooterColumns theme={theme} class="t-footer-cols" />
        </div>
        <div class="t-footer-bottom">
          <span>© {new Date().getFullYear()} {site.name}{site.location && ` · ${site.location}`}</span>
          <span class="g-only">lvl <b data-game-level>1</b> · <button type="button" class="t-btn" data-open-ach>achievements</button> <button type="button" class="t-btn" data-open-shop>shop</button></span>
        </div>
      </footer>
    </div>
    <AchievementsDialog />
    <AccountDialogs ownerName={site.name} />
    <ThemeLock item={`theme:${theme}`} slug={slug} />
    <GameBoot />
  </body>
</html>
