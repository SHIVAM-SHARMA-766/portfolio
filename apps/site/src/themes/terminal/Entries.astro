---
import Cmd from './Cmd.astro';
import { md } from '../../lib/content';
import type { Entry } from '../../lib/entries';
interface Props { heading: string; items: Entry[]; cmd: string }
const { heading, items, cmd } = Astro.props;
---
<Cmd cmd={cmd}>
  <h2 class="t-h"># {heading}</h2>
  <ul class="t-entries">
    {items.map((e) => (
      <li>
        <p class="t-entry__title">{e.href ? <a href={e.href} target="_blank" rel="noopener">{e.title}</a> : e.title}{e.badge && <span class="t-tag">{e.badge.toLowerCase()}</span>}</p>
        {(e.subtitle || e.meta) && <p class="t-dim">{[e.subtitle, e.meta].filter(Boolean).join(' · ')}</p>}
        {e.body && <div class="t-entry__body" set:html={md(e.body)} />}
        {e.tags && e.tags.length > 0 && <p class="t-tags">{e.tags.map((t) => <span class="t-tag">{t}</span>)}</p>}
      </li>
    ))}
  </ul>
</Cmd>
