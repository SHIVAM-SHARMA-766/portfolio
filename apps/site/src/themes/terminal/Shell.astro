---
// Interactive prompt at the bottom of every terminal page. The logic lives in
// shell.ts; the filesystem and missions are built from content in fs.ts.
import { THEMES, site } from '../../lib/content';
import { palettesFor } from '@portfolio/tokens';
import { buildFs } from './fs';
interface Props { theme: string }
const { theme } = Astro.props;
const built = await buildFs(theme);
const data = {
  ...built,
  themes: THEMES.map((t) => t.id),
  palettes: palettesFor(theme).map((p) => p.id),
  email: site.email ?? '',
  name: site.name,
  role: site.role,
  learnUrl: site.learnUrl ?? '',
  theme,
};
---
<section class="t-shell" aria-label="Interactive terminal">
  <div class="t-shell-out" id="shell-out" aria-live="polite"></div>
  <form class="t-shell-form" id="shell-form" autocomplete="off">
    <label for="shell-in"><span class="t-ps1">shivam@portfolio</span><span class="t-dim" id="shell-cwd">:~$</span></label>
    <input id="shell-in" name="cmd" spellcheck="false" autocapitalize="off" placeholder="type 'missions' and press Enter" />
  </form>
  <script type="application/json" id="shell-data" set:html={JSON.stringify(data)}></script>
</section>

<script>
  import { startShell } from './shell';
  startShell();
</script>

<script>
  // "try the shell" links and the floating $_ button: scroll to the prompt and
  // focus it. The button hides while the prompt is on screen.
  const input = document.getElementById('shell-in') as HTMLInputElement | null;
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.('[data-focus-shell]');
    if (!a || !input) return;
    e.preventDefault();
    input.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
    setTimeout(() => input.focus({ preventScroll: true }), 300);
  });
  const fab = document.querySelector<HTMLElement>('.t-shell-fab');
  if (input && fab) new IntersectionObserver(([en]) => fab.classList.toggle('is-hidden', en.isIntersecting)).observe(input);
</script>
