---
import Cmd from '../Cmd.astro';
import { mdInline, resolveHref } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'timeline'>; theme: string };
---
<Cmd cmd="git log --reverse --oneline --life">
  {block.heading && <h2 class="t-h"># {block.heading}</h2>}
  {block.body && <p set:html={mdInline(block.body)} />}
  <ol class="t-journey">
    {block.items.map((it) => (
      <li>
        <span class="t-journey__when">{it.date}</span>
        <div>
          <p class="t-journey__title">{it.tag && <span class="t-tag">{it.tag.toLowerCase()}</span>} {it.href ? <a href={resolveHref(theme, it.href)}>{it.title}</a> : it.title}</p>
          {it.body && <p class="t-journey__body" set:html={mdInline(it.body)} />}
        </div>
      </li>
    ))}
  </ol>
</Cmd>
