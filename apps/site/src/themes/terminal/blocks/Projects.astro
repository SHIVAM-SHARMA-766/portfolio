---
import Cmd from '../Cmd.astro';
import { profile } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block } = Astro.props as { block: BlockOf<'projects'> };
let list = block.filter === 'featured' ? profile.projects.filter((p) => p.featured) : profile.projects;
if (block.limit) list = list.slice(0, block.limit);
---
<Cmd cmd={`ls -la projects/${block.filter === 'featured' ? ' | grep featured' : ''}`}>
  {block.heading && <h2 class="t-h"># {block.heading}</h2>}
  <p class="t-dim">total {list.length} — click a project to open its README (+15 XP)</p>
  {list.map((p) => (
    <details class="t-details t-project" data-xp="15" data-xp-id={`project:${p.slug}`} data-xp-label={p.name}>
      <summary><span class="t-dim">drwxr-xr-x {p.year ?? ''}</span> <span class="t-acc">{p.slug}/</span>{p.featured && <span class="t-tag">★ featured</span>}</summary>
      <div class="t-readme">
        <p class="t-dim">$ cat projects/{p.slug}/README.md</p>
        <h3>{p.name}</h3>
        <p>{p.summary}</p>
        {p.highlights.length > 0 && <ul class="t-list">{p.highlights.map((h) => <li>{h}</li>)}</ul>}
        <p class="t-tags">{p.tags.map((t) => <span class="t-tag">{t}</span>)}</p>
        {p.links.length > 0 && <p>{p.links.map((l) => <a class="t-link-btn" href={l.url} target="_blank" rel="noopener">[ {l.label} ↗ ]</a>)}</p>}
      </div>
    </details>
  ))}
</Cmd>
