---
import Cards from './Cards.astro';
import { profile } from '../../../lib/content';
import { bases, projectCard } from '../../../lib/details';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'projects'>; theme: string };
let list = block.filter === 'featured' ? profile.projects.filter((p) => p.featured) : profile.projects;
if (block.limit) list = list.slice(0, block.limit);
const { projects: base } = await bases();
---
<Cards theme={theme} block={{ type: 'cards', heading: block.heading, body: null, columns: 3, items: list.map((p) => projectCard(p, base)) }} />
