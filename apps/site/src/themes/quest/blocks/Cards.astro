---
import Panel from '../Panel.astro';
import { mdInline, resolveHref } from '../../../lib/content';
import { xpAttrs, hue, initialsOf, isExternal } from '../../../lib/cards';
import type { BlockOf } from '../../../lib/schema';
import { srcsetFor } from '../../../lib/images';
const { block, theme } = Astro.props as { block: BlockOf<'cards'>; theme: string };
const media = (c: (typeof block.items)[number]) => !!c.image || !!c.xp?.id.startsWith('project:');
const sets = await Promise.all(block.items.map((c) => srcsetFor(c.image)));
---
<Panel title={block.heading ?? undefined} icon="📜">
  {block.body && <p set:html={mdInline(block.body)} />}
  <div class="q-board" style={block.columns ? `--cols:${block.columns}` : undefined}>
    {block.items.map((c) => {
      const Tag = c.href ? 'a' : 'article';
      const link = c.href ? { href: resolveHref(theme, c.href), ...(isExternal(c.href) ? { target: '_blank', rel: 'noopener' } : {}) } : {};
      return (
        <Tag class={`q-card q-card--link ${c.badge ? 'q-card--legendary' : ''}`} {...link} {...xpAttrs(c)}>
          {(c.badge || c.xp) && <span class="q-rarity">{c.badge ?? 'Rare'}</span>}
          {media(c) && (
            <span class="q-card-media" style={`--h:${hue(c.title)}`}>
              {c.image ? <img src={c.image} srcset={sets[block.items.indexOf(c)]} sizes="(max-width: 760px) 100vw, 360px" alt="" loading="lazy" decoding="async" /> : <b aria-hidden="true">{c.icon ?? initialsOf(c.title)}</b>}
            </span>
          )}
          {c.meta && <small class="q-muted">{c.meta}</small>}
          <h3>{!media(c) && c.icon && <span aria-hidden="true">{c.icon} </span>}{c.title}</h3>
          {c.body && <p set:html={mdInline(c.body)} />}
          {c.tags.length > 0 && <p class="q-loot">{c.tags.map((t) => <span>{t}</span>)}</p>}
          {c.href && <span class="q-card-cta">▶ {c.cta ?? 'Open'}{c.xp && <small> · +{c.xp.points} XP</small>}</span>}
        </Tag>
      );
    })}
  </div>
</Panel>
