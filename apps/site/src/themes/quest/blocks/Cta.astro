---
import { resolveHref, mdInline } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'cta'>; theme: string };
---
<section class="q-panel q-chest">
  <span class="q-chest-icon" aria-hidden="true">🎁</span>
  <div>
    <h2 class="q-title">{block.heading}</h2>
    {block.body && <p set:html={mdInline(block.body)} />}
    <a class="q-btn q-btn--big" href={resolveHref(theme, block.href)}>▶ {block.label}</a>
  </div>
</section>
