---
import { site, resolveHref, mdInline } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'hero'>; theme: string };
const initials = site.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<section class="q-hero">
  <div class="q-portrait" aria-hidden="true"><span>{initials}</span></div>
  <div class="q-dialog">
    <p class="q-nametag">{block.heading}</p>
    <h1 class="q-hero-title">{block.subheading ?? block.heading}</h1>
    {block.body && <p set:html={mdInline(block.body)} />}
    {block.ctas.length > 0 && (
      <ul class="q-choices">
        {block.ctas.map((c) => <li><a href={resolveHref(theme, c.href)}>{c.label}</a></li>)}
      </ul>
    )}
    <span class="q-next" aria-hidden="true">▼</span>
  </div>
</section>
