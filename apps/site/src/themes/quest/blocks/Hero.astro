---
import { resolveHref, mdInline, photo, initials, site, contactLinks } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'hero'>; theme: string };
---
<section class="q-hero">
  <div class={photo ? 'q-portrait q-scene' : 'q-portrait'} aria-hidden={photo ? undefined : 'true'}>
    {photo ? (
      <img class={photo.cutout ? "q-photo" : "q-photo q-photo--crop"} src={photo.cutout ?? photo.src} alt={photo.alt} width="480" height="600" style={photo.cutout ? undefined : `object-position:${photo.position}`} />
    ) : <span>{initials}</span>}
  </div>
  <div class="q-dialog">
    {block.subheading && <p class="q-nametag">{block.subheading}</p>}
    {site.availability && <p class="q-available">✦ {site.availability}</p>}
    <h1 class="q-hero-title">{block.heading}</h1>
    {block.body && <p set:html={mdInline(block.body)} />}
    {block.ctas.length > 0 && (
      <div class="q-actions q-hero-actions">
        {block.ctas.map((c, i) => <a class={i === 0 ? 'q-btn' : 'q-btn q-btn--ghost'} href={resolveHref(theme, c.href)}>▶ {c.label}</a>)}
        {site.resume && <a class="q-btn q-btn--ghost" href={site.resume} target="_blank" rel="noopener">📜 CV</a>}
      </div>
    )}
    {contactLinks.length > 0 && (
      <p class="q-hero-links">{contactLinks.map((l) => <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external ? ' ↗' : ''}</a>)}</p>
    )}
    <span class="q-next" aria-hidden="true">▼</span>
  </div>
</section>

