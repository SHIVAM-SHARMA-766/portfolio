---
import Panel from '../Panel.astro';
import { profile } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block } = Astro.props as { block: BlockOf<'projects'> };
let list = block.filter === 'featured' ? profile.projects.filter((p) => p.featured) : profile.projects;
if (block.limit) list = list.slice(0, block.limit);
---
<Panel title={block.heading ?? 'Quest board'} icon="🗺️">
  <div class="q-board">
    {list.map((p) => (
      <article class={`q-card ${p.featured ? 'q-card--legendary' : ''}`}>
        <span class="q-rarity">{p.featured ? 'Legendary' : 'Rare'}</span>
        <h3>{p.name}</h3>
        <p>{p.summary}</p>
        <p class="q-loot">{p.tags.map((t) => <span>{t}</span>)}</p>
        <details class="q-accept" data-xp="15" data-xp-id={`project:${p.slug}`} data-xp-label={`Quest accepted: ${p.name}`}>
          <summary>▶ Accept quest</summary>
          {p.highlights.length > 0 && <ul class="q-list">{p.highlights.map((h) => <li>{h}</li>)}</ul>}
          {p.links.map((l) => <a class="q-btn" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </details>
      </article>
    ))}
  </div>
</Panel>
