---
import Head from '../../components/Head.astro';
import Switcher from '../../components/Switcher.astro';
import GameBoot from '../../components/GameBoot.astro';
import AchievementsDialog from '@portfolio/game/AchievementsDialog.astro';
import AccountDialogs from '@portfolio/game/AccountDialogs.astro';
import AccountChip from '../../components/AccountChip.astro';
import ThemeLock from '../../components/ThemeLock.astro';
import Logo from '../../components/Logo.astro';
import FooterColumns from '../../components/FooterColumns.astro';
import MessageBubble from '../../components/MessageBubble.astro';
import { site, pageUrl, photo, initials as siteInitials } from '../../lib/content';
import type { Page } from '../../lib/schema';
import './quest.css';

interface Props { theme: string; title: string; description?: string; slug: string; nav: Page[]; pageIdent: string | null; current?: string; image?: string | null }
const { theme, title, description, slug, nav, pageIdent, current = slug, image } = Astro.props;
---
<html lang="en" data-theme="quest">
  <Head theme={theme} title={title} description={description} slug={slug} pageIdent={pageIdent} image={image}
    preloadFonts={['/fonts/pixelify-sans-latin.woff2', '/fonts/press-start-2p-latin.woff2']} />
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="q-hud">
      <a class="q-avatar" href={pageUrl(theme, '')} aria-label="Home">
        {photo ? <img class="q-avatar-img" src={photo.cutout ?? photo.src} alt="" width="48" height="48" /> : siteInitials}
      </a>
      <div class="q-who">
        <strong class="q-brand"><Logo size={18} label={site.name} /><span class="g-only">Level <b data-game-level>1</b></span></strong>
        <span class="g-only" data-game-level-name>Visitor</span>
      </div>
      <div class="q-xp g-only">
        <div class="q-xpbar" data-game-progress role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100"><span></span></div>
        <small><span class="q-coin" aria-hidden="true"></span><b data-game-xp>0</b> XP · <span data-game-next></span></small>
      </div>
      <div class="q-hud-actions">
        <AccountChip />
        <button type="button" class="q-btn g-only" data-open-ach>🏆 <span class="q-hide-sm">Quest log</span> <span data-game-ach-count>0/0</span></button>
      </div>
    </header>

    <nav class="q-map" aria-label="World map">
      {nav.map((p) => (
        <a class="q-zone" href={pageUrl(theme, p.slug)} aria-current={p.slug === current ? 'page' : undefined}>
          <span class="q-zone-icon" aria-hidden="true">{p.icon ?? '⭐'}</span>
          <span>{p.navLabel ?? p.title}</span>
        </a>
      ))}
      {site.learnUrl && <a class="q-zone" href={site.learnUrl}><span class="q-zone-icon" aria-hidden="true">🏯</span><span>Dojo ↗</span></a>}
    </nav>

    <script is:inline>
      // Phones: bring the current zone into view in the scrollable map
      document.querySelector('.q-map [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    </script>
    <main id="main" class="q-main">
      <slot />
      <div data-game-end aria-hidden="true"></div>
    </main>

    <footer class="q-footer">
      <details class="q-settings">
        <summary>⚙️ Settings — themes & palettes</summary>
        <Switcher theme={theme} slug={slug} />
      </details>
      <div class="q-panel q-footer-card">
        <div class="q-footer-brand">
          <p class="q-footer-name"><Logo size={28} /> {site.name}</p>
          <p>{site.tagline}</p>
          {site.email && <a class="q-btn" href={`mailto:${site.email}`}>🕊️ Send a raven</a>}
        </div>
        <FooterColumns theme={theme} class="q-footer-cols" />
      </div>
      <div class="q-footer-bottom">
        <p>© {new Date().getFullYear()} {site.name}{site.location && ` · ${site.location}`}</p>
        <p class="q-tip g-only">Tip: legends speak of a secret code… ↑ ↑ ↓ ↓</p>
      </div>
    </footer>
    <AchievementsDialog />
    <AccountDialogs ownerName={site.name} />
    <ThemeLock item={`theme:${theme}`} slug={slug} />
    <GameBoot />
    <MessageBubble />
  </body>
</html>
