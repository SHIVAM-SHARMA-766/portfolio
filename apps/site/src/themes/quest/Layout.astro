---
import Head from '../../components/Head.astro';
import Switcher from '../../components/Switcher.astro';
import GameBoot from '../../components/GameBoot.astro';
import AchievementsDialog from '@portfolio/game/AchievementsDialog.astro';
import AccountDialogs from '@portfolio/game/AccountDialogs.astro';
import AccountChip from '../../components/AccountChip.astro';
import ThemeLock from '../../components/ThemeLock.astro';
import Logo from '../../components/Logo.astro';
import { site, pageUrl, photo, initials as siteInitials } from '../../lib/content';
import type { Page } from '../../lib/schema';
import './quest.css';

interface Props { theme: string; title: string; description?: string; slug: string; nav: Page[]; pageIdent: string | null; current?: string }
const { theme, title, description, slug, nav, pageIdent, current = slug } = Astro.props;
---
<html lang="en" data-theme="quest">
  <Head theme={theme} title={title} description={description} slug={slug} pageIdent={pageIdent}
    fonts="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Pixelify+Sans:wght@400;600&display=swap" />
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="q-hud">
      <a class="q-avatar" href={pageUrl(theme, '')} aria-label="Home">
        {photo ? <canvas class="q-pixel q-pixel--avatar" width="20" height="20" data-pixel-src={photo.cutout ?? photo.src} data-pixel-crop={photo.cutout ? '0.2 0.1 0.6 0.48' : undefined} data-pixel-pos="50% 22%" aria-hidden="true"></canvas> : siteInitials}
      </a>
      <div class="q-who">
        <strong class="q-brand"><Logo pixel size={18} class="logo-blink" />{site.name}</strong>
        <span class="g-only">LV <b data-game-level>1</b> · <span data-game-level-name>Visitor</span></span>
      </div>
      <div class="q-xp g-only">
        <div class="q-xpbar" data-game-progress role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100"><span></span></div>
        <small><span class="q-coin" aria-hidden="true"></span><b data-game-xp>0</b> XP · <span data-game-next></span></small>
      </div>
      <div class="q-hud-actions">
        <AccountChip />
        <button type="button" class="q-btn g-only" data-open-ach>🏆 <span class="q-hide-sm">Quest log</span> <span data-game-ach-count>0/0</span></button>
        <button type="button" class="q-btn q-btn--ghost" data-game-toggle data-off-text="Skip game" data-on-text="Play game"><span data-label>Skip game</span></button>
      </div>
    </header>

    <nav class="q-map" aria-label="World map">
      {nav.map((p) => (
        <a class="q-zone" href={pageUrl(theme, p.slug)} aria-current={p.slug === current ? 'page' : undefined}>
          <span class="q-zone-icon" aria-hidden="true">{p.icon ?? '⭐'}</span>
          <span>{p.navLabel ?? p.title}</span>
        </a>
      ))}
      {site.learnUrl && <a class="q-zone" href={site.learnUrl}><span class="q-zone-icon" aria-hidden="true">🏯</span><span>Dojo ↗</span></a>}
    </nav>

    <main id="main" class="q-main">
      <slot />
      <div data-game-end aria-hidden="true"></div>
    </main>

    <footer class="q-footer">
      <details class="q-settings">
        <summary>⚙️ Settings — themes & palettes</summary>
        <Switcher theme={theme} slug={slug} />
      </details>
      <p class="q-tip g-only">Tip: legends speak of a secret code… ↑ ↑ ↓ ↓</p>
      <p>© {new Date().getFullYear()} {site.name}</p>
    </footer>
    <AchievementsDialog />
    <AccountDialogs ownerName={site.name} />
    <ThemeLock item={`theme:${theme}`} slug={slug} />
    <GameBoot />
    <script>
  // Turn the portrait into pixel art. With a cut-out (transparent background)
  // it becomes a proper sprite: shrunk to the canvas, reduced to a 16-colour
  // palette (median cut), hard alpha, and a 1px dark outline. CSS scales it up
  // without smoothing. Without a cut-out the photo is cropped around its focus.
  type RGB = [number, number, number];
  function palette(pixels: RGB[], n: number): RGB[] {
    let boxes: RGB[][] = [pixels];
    while (boxes.length < n) {
      let bi = -1, bc = 0, best = 0;
      boxes.forEach((box, i) => {
        if (box.length < 2) return;
        for (let c = 0; c < 3; c++) {
          let lo = 255, hi = 0;
          for (const p of box) { if (p[c] < lo) lo = p[c]; if (p[c] > hi) hi = p[c]; }
          if (hi - lo > best) { best = hi - lo; bi = i; bc = c; }
        }
      });
      if (bi < 0) break;
      const box = boxes[bi].sort((p, q) => p[bc] - q[bc]);
      boxes.splice(bi, 1, box.slice(0, box.length >> 1), box.slice(box.length >> 1));
    }
    return boxes.map((box) => [0, 1, 2].map((c) => Math.round(box.reduce((s, p) => s + p[c], 0) / box.length)) as RGB);
  }

  function sprite(cv: HTMLCanvasElement, img: HTMLImageElement) {
    const W = cv.width, H = cv.height, ctx = cv.getContext('2d', { willReadFrequently: true })!;
    let sx: number, sy: number, sw: number, sh: number;
    const crop = cv.dataset.pixelCrop?.split(/\s+/).map(Number);
    if (crop?.length === 4) {
      [sx, sy, sw, sh] = [crop[0] * img.width, crop[1] * img.height, crop[2] * img.width, crop[3] * img.height];
    } else {
      const [fx, fy] = (cv.dataset.pixelPos ?? '50% 25%').split(/\s+/).map((v) => parseFloat(v) / 100);
      sw = img.width; sh = img.height;
      if (sw / sh > W / H) sw = sh * (W / H); else sh = sw / (W / H);
      sx = (img.width - sw) * (isNaN(fx) ? 0.5 : fx);
      sy = (img.height - sh) * (isNaN(fy) ? 0.25 : fy);
    }
    // Shrink in two steps (cleaner than one big jump), punching up colour a bit
    const mid = document.createElement('canvas');
    mid.width = W * 2; mid.height = H * 2;
    const m = mid.getContext('2d')!;
    m.imageSmoothingQuality = 'high';
    m.filter = 'saturate(1.25) contrast(1.15)';
    m.drawImage(img, sx, sy, sw, sh, 0, 0, mid.width, mid.height);
    ctx.clearRect(0, 0, W, H);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(mid, 0, 0, W, H);

    const d = ctx.getImageData(0, 0, W, H), px = d.data;
    const cutout = 'pixelCutout' in cv.dataset;
    const solid = (i: number) => !cutout || px[i * 4 + 3] > 110;
    const opaque: RGB[] = [];
    for (let i = 0; i < W * H; i++) if (solid(i)) opaque.push([px[i * 4], px[i * 4 + 1], px[i * 4 + 2]]);
    const pal = palette(opaque, 16);
    const near = (r: number, g: number, b: number) => {
      let best = pal[0], bd = Infinity;
      for (const p of pal) { const dd = (p[0] - r) ** 2 + (p[1] - g) ** 2 + (p[2] - b) ** 2; if (dd < bd) { bd = dd; best = p; } }
      return best;
    };
    const mask = new Uint8Array(W * H);
    for (let i = 0; i < W * H; i++) {
      if (solid(i)) { const [r, g, b] = near(px[i * 4], px[i * 4 + 1], px[i * 4 + 2]); px.set([r, g, b, 255], i * 4); mask[i] = 1; }
      else px[i * 4 + 3] = 0;
    }
    ctx.putImageData(d, 0, 0);
    if (cutout && cv.dataset.pixelOutline !== '0') {
      ctx.fillStyle = getComputedStyle(cv).getPropertyValue('--sprite-outline').trim() || '#140f24';
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        if (mask[y * W + x]) continue;
        if ((x > 0 && mask[y * W + x - 1]) || (x < W - 1 && mask[y * W + x + 1]) || (y > 0 && mask[(y - 1) * W + x]) || (y < H - 1 && mask[(y + 1) * W + x])) ctx.fillRect(x, y, 1, 1);
      }
    }
    cv.classList.add('is-ready');
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-pixel-src]').forEach((cv) => {
    const img = new Image();
    img.onload = () => sprite(cv, img);
    img.src = cv.dataset.pixelSrc!;
  });
</script>

  </body>
</html>
