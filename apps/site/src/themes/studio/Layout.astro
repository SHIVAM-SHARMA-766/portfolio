---
import Head from '../../components/Head.astro';
import Switcher from '../../components/Switcher.astro';
import GameBoot from '../../components/GameBoot.astro';
import AchievementsDialog from '@portfolio/game/AchievementsDialog.astro';
import AccountDialogs from '@portfolio/game/AccountDialogs.astro';
import AccountChip from '../../components/AccountChip.astro';
import ThemeLock from '../../components/ThemeLock.astro';
import Logo from '../../components/Logo.astro';
import FooterColumns from '../../components/FooterColumns.astro';
import MessageBubble from '../../components/MessageBubble.astro';
import { site, pageUrl } from '../../lib/content';
import type { Page } from '../../lib/schema';
import './studio.css';

interface Props { theme: string; title: string; description?: string; slug: string; nav: Page[]; pageIdent: string | null; current?: string; image?: string | null }
const { theme, title, description, slug, nav, pageIdent, current = slug, image } = Astro.props;
---
<html lang="en" data-theme="studio">
  <Head theme={theme} title={title} description={description} slug={slug} pageIdent={pageIdent} image={image}
    fonts="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" />
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="s-top">
      <div class="s-wrap s-top-inner">
        <a class="s-logo" href={pageUrl(theme, '')} aria-label={`${site.name} — home`}><Logo size={32} /></a>
        <nav class="s-nav" aria-label="Pages">
          {nav.filter((p) => p.slug !== '').map((p) => (
            <a href={pageUrl(theme, p.slug)} aria-current={p.slug === current ? 'page' : undefined}>{p.navLabel ?? p.title}</a>
          ))}
          {site.learnUrl && <a href={site.learnUrl}>Learn ↗</a>}
        </nav>
        <div class="s-tools">
          <AccountChip />
          <button type="button" class="s-pill g-only" data-open-ach aria-label="Your points and achievements">
            <span class="s-ring" data-game-progress aria-hidden="true"></span>
            <span><b data-game-xp>0</b> XP</span><span class="s-pill-coins" aria-label="coins">🪙 <b data-game-coins>0</b></span>
          </button>
          <details class="s-appearance">
            <summary aria-label="Appearance" title="Theme &amp; colours">Aa</summary>
            <div class="s-pop"><Switcher theme={theme} slug={slug} /></div>
          </details>
        </div>
      </div>
    </header>
    <main id="main" class="s-main">
      <slot />
      <div data-game-end aria-hidden="true"></div>
    </main>
    <footer class="s-footer">
      <div class="s-wrap">
        <div class="s-footer-top">
          <div class="s-footer-brand">
            <a class="s-logo" href={pageUrl(theme, '')} aria-label={`${site.name} — home`}><Logo size={36} /></a>
            <p class="s-footer-name">{site.name}</p>
            <p>{site.tagline}</p>
            {site.email && <a class="s-btn s-btn--sm" href={`mailto:${site.email}`}>Say hello →</a>}
          </div>
          <FooterColumns theme={theme} class="s-footer-cols" />
        </div>
        <div class="s-footer-bottom">
          <p>© {new Date().getFullYear()} {site.name}{site.location && ` · ${site.location}`}</p>
          <p class="g-only">You're level <b data-game-level>1</b> · <button type="button" class="s-link" data-open-ach>Achievements</button> · <button type="button" class="s-link" data-open-shop>Shop</button></p>
        </div>
      </div>
    </footer>
    <AchievementsDialog />
    <AccountDialogs ownerName={site.name} />
    <ThemeLock item={`theme:${theme}`} slug={slug} />
    <GameBoot />
    <MessageBubble />
  </body>
</html>
