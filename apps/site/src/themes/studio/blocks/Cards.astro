---
import { mdInline, resolveHref } from '../../../lib/content';
import { xpAttrs, hue, initialsOf, isExternal } from '../../../lib/cards';
import type { BlockOf } from '../../../lib/schema';
import { srcsetFor } from '../../../lib/images';
const { block, theme } = Astro.props as { block: BlockOf<'cards'>; theme: string };
const cols = block.columns ?? Math.min(3, Math.max(1, block.items.length));
// A generated cover only for projects; other cards without an image stay text-only
const media = (c: (typeof block.items)[number]) => !!c.image || !!c.xp?.id.startsWith('project:');
const sets = await Promise.all(block.items.map((c) => srcsetFor(c.image)));
---
<section class="s-wrap s-section">
  {block.heading && <h2 class="s-h2">{block.heading}</h2>}
  {block.body && <p class="s-lead s-cards-intro" set:html={mdInline(block.body)} />}
  <div class="s-cards" style={`--cols:${cols}`}>
    {block.items.map((c) => {
      const Tag = c.href ? 'a' : 'article';
      const link = c.href ? { href: resolveHref(theme, c.href), ...(isExternal(c.href) ? { target: '_blank', rel: 'noopener' } : {}) } : {};
      return (
        <Tag class="s-tile" {...link} {...xpAttrs(c)}>
          {media(c) && (
            <div class="s-tile__media" style={`--h:${hue(c.title)}`}>
              {c.image ? <img src={c.image} srcset={sets[block.items.indexOf(c)]} sizes={`(max-width: 760px) 100vw, ${Math.round(1100 / cols)}px`} alt="" loading="lazy" decoding="async" /> : <span aria-hidden="true">{c.icon ?? initialsOf(c.title)}</span>}
            </div>
          )}
          <div class="s-tile__body">
            {(c.meta || c.badge) && <p class="s-tile__meta">{c.meta}{c.badge && <b>{c.badge}</b>}</p>}
            <h3>{!media(c) && c.icon && <span aria-hidden="true">{c.icon} </span>}{c.title}</h3>
            {c.body && <p set:html={mdInline(c.body)} />}
            {c.tags.length > 0 && <p class="s-chips">{c.tags.map((t) => <span>{t}</span>)}</p>}
            {c.href && <span class="s-tile__cta">{c.cta ?? 'Open'} →</span>}
          </div>
        </Tag>
      );
    })}
  </div>
</section>
