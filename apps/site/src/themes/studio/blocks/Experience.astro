---
import { profile, formatMonth, rewards, ids } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block } = Astro.props as { block: BlockOf<'experience'> };
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);
---
<section class="s-wrap s-section">
  {block.heading && <h2 class="s-h2">{block.heading}</h2>}
  <ol class="s-timeline">
    {profile.experience.map((job) => (
      <li>
        <p class="s-when">{formatMonth(job.start)} — {formatMonth(job.end)}</p>
        <div>
          <h3>{job.role}, <span class="s-muted">{job.company}</span></h3>
          {job.location && <p class="s-muted">{job.location}</p>}
          {job.progression && <p class="s-small">{job.progression}</p>}
          {job.highlights.length > 0 && <ul>{job.highlights.map((h) => <li>{h}</li>)}</ul>}
          {job.engagements.map((e) => (
            <details class="s-card s-eng" data-xp={rewards.experience} data-xp-id={ids.experience(e.title)} data-xp-label="Reading the details" open>
              <summary>{e.title}</summary>
              <ul>{e.highlights.map((h) => <li>{h}</li>)}</ul>
            </details>
          ))}
        </div>
      </li>
    ))}
  </ol>
</section>
