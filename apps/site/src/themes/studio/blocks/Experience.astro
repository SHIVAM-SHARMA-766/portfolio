---
import Cards from './Cards.astro';
import { profile, mdInline } from '../../../lib/content';
import { bases, engagementCard, jobSlug, period, shortTitle, engagementSlug } from '../../../lib/details';
import { xpAttrs } from '../../../lib/cards';
import { positionsOf, jobMeta, duration } from '../../../lib/entries';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'experience'>; theme: string };
const { experience: base } = await bases();
const cards = profile.experience.flatMap((job) => job.engagements.map((e) => engagementCard(job, e, base)));
---
{block.compact ? (
  <Cards theme={theme} block={{ type: 'cards', heading: block.heading, body: null, columns: 2, items: cards }} />
) : (
  <section class="s-wrap s-section">
    {block.heading && <h2 class="s-h2">{block.heading}</h2>}
    <ol class="s-timeline">
      {profile.experience.map((job) => (
        <li>
          <p class="s-when">{period(job)}</p>
          <div>
            <h3><a class="s-plain" href={`/${base}/${jobSlug(job)}/`}>{job.role}, <span class="s-muted">{job.company}</span></a></h3>
            <p class="s-muted">{[jobMeta(job), duration(job.start, job.end)].filter(Boolean).join(' · ')}</p>
            {positionsOf(job).length > 1 && <ol class="s-positions">{positionsOf(job).map((p) => <li><b>{p.title}</b><span class="s-muted">{[p.when, p.length].filter(Boolean).join(' · ')}</span></li>)}</ol>}
            {job.skills.length > 0 && <p class="s-chips">{job.skills.map((t) => <span>{t}</span>)}</p>}
            {job.highlights.length > 0 && <ul>{job.highlights.map((h) => <li>{h}</li>)}</ul>}
            {job.engagements.map((e) => {
              const card = engagementCard(job, e, base);
              return (
                <article class="s-card s-eng">
                  <h4>{shortTitle(e.title)}</h4>
                  {e.summary && <p class="s-muted" set:html={mdInline(e.summary)} />}
                  <ul>{e.highlights.slice(0, 3).map((h) => <li>{h}</li>)}</ul>
                  <a class="s-arrow" href={`/${base}/${jobSlug(job)}/${engagementSlug(e)}/`} {...xpAttrs(card)}>Read the full story →</a>
                </article>
              );
            })}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
