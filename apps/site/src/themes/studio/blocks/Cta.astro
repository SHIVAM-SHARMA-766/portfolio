---
import { resolveHref, mdInline } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'cta'>; theme: string };
---
<section class="s-wrap s-section">
  <div class="s-band">
    <div><h2 class="s-h2">{block.heading}</h2>{block.body && <p set:html={mdInline(block.body)} />}</div>
    <a class="s-btn" href={resolveHref(theme, block.href)}>{block.label}</a>
  </div>
</section>
