---
import { mdInline } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block } = Astro.props as { block: BlockOf<'glance'> };
---
<section class="s-wrap s-glance">
  {block.heading && <h2 class="s-h2">{block.heading}</h2>}
  <div class="s-glance__grid">
    {block.facts.length > 0 && (
      <dl class="s-facts">
        {block.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.href ? <a href={f.href} target="_blank" rel="noopener">{f.value} ↗</a> : f.value}</dd></div>)}
      </dl>
    )}
    {block.points.length > 0 && <ul class="s-points">{block.points.map((p) => <li set:html={mdInline(p)} />)}</ul>}
  </div>
</section>
