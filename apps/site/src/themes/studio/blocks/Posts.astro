---
import { getPosts } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block, theme } = Astro.props as { block: BlockOf<'posts'>; theme: string };
let posts = await getPosts();
if (block.limit) posts = posts.slice(0, block.limit);
---
<section class="s-wrap s-section">
  {block.heading && <h2 class="s-h2">{block.heading}</h2>}
  {posts.length === 0 && <p class="s-muted">No posts yet.</p>}
  <ul class="s-posts">
    {posts.map((p) => (
      <li><a href={`/${theme}/blog/${p.id}/`}><time class="s-muted">{p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time><span><b>{p.data.title}</b><span class="s-muted">{p.data.description}</span></span></a></li>
    ))}
  </ul>
</section>
