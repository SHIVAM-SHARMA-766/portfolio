---
import { getCourses } from '../../../lib/content';
import type { BlockOf } from '../../../lib/schema';
const { block } = Astro.props as { block: BlockOf<'courses'> };
const courses = getCourses();
---
{courses.length > 0 && (
  <section class="s-wrap s-section">
    {block.heading && <h2 class="s-h2">{block.heading}</h2>}
    <div class="s-grid">
      {courses.map((c) => (
        <a class="s-card s-project s-cardlink" href={c.url}>
          <p class="s-small s-muted">{c.level} · {c.lessons} lessons · {c.duration}</p>
          <h3>{c.icon} {c.title}</h3>
          <p>{c.description}</p>
          <span class="s-arrow">Start learning →</span>
        </a>
      ))}
    </div>
  </section>
)}
