---
import { mdInline, md } from '../../lib/content';
import type { Entry } from '../../lib/entries';
interface Props { heading: string; items: Entry[]; icon?: string }
const { heading, items } = Astro.props;
---
<section class="s-wrap s-split">
  <h2 class="s-h2">{heading}</h2>
  <ul class="s-entries">
    {items.map((e) => (
      <li>
        <p class="s-entry__title">{e.href ? <a class="s-plain" href={e.href} target="_blank" rel="noopener">{e.title} ↗</a> : e.title}{e.badge && <span class="s-entry__badge">{e.badge}</span>}</p>
        {e.subtitle && <p class="s-entry__sub">{e.subtitle}</p>}
        {e.meta && <p class="s-entry__meta">{e.meta}</p>}
        {e.body && <div class="s-entry__body" set:html={md(e.body)} />}
        {e.tags && e.tags.length > 0 && <p class="s-chips">{e.tags.map((t) => <span>{t}</span>)}</p>}
      </li>
    ))}
  </ul>
</section>
