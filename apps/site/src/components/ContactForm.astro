---
// The contact page's message form. Only signed-in visitors can write (no
// anonymous messages, so no spam): the message joins their conversation with
// me, and my replies show up in the message bubble. Signed-out visitors see a
// sign-in button. Every theme passes its own button class.
import { site } from '../lib/content';
interface Props { btnClass?: string; label?: string }
const { btnClass = '', label = 'Send message' } = Astro.props;
const api = site.apiUrl?.replace(/\/$/, '');
const topics = [['job', 'A job opportunity'], ['freelance', 'Freelance or contract work'], ['collaboration', 'Collaboration or open source'], ['question', 'A question'], ['other', 'Something else']];
---
{api && (
  <div class="cf-wrap" data-contact-form data-api={api}>
    <div class="cf-gate">
      <p>Sign in with Google, GitHub or LinkedIn to send me a message. It keeps my inbox free of spam, and you'll see my reply on this site.</p>
      <button type="button" class={btnClass} data-open-login>Sign in to message</button>
    </div>
    <form class="cf" novalidate>
      <p class="cf-as">Sending as <b data-cf-who></b></p>
      <label class="cf-field"><span>What is it about?</span>
        <select name="topic">{topics.map(([v, l]) => <option value={v}>{l}</option>)}</select>
      </label>
      <label class="cf-field"><span>Message</span><textarea name="message" rows="6" required maxlength="5000" /></label>
      <div class="cf-foot">
        <button type="submit" class={btnClass}>{label}</button>
        <p class="cf-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
)}

<style>
  .cf-wrap { margin-top: 1.5rem; max-width: 40rem; }
  .cf-wrap:not([data-signed-in]) .cf, .cf-wrap[data-signed-in] .cf-gate { display: none; }
  .cf-gate { display: grid; gap: .8rem; justify-items: start; }
  .cf-gate p, .cf-as { margin: 0; color: var(--muted); }
  .cf { display: grid; gap: .9rem; }
  .cf-field { display: grid; gap: .35rem; font-size: .9rem; }
  .cf-field > span { color: var(--muted); }
  .cf select, .cf textarea {
    font: inherit; color: var(--fg); background: var(--surface, transparent);
    border: 1px solid var(--border); border-radius: var(--cf-radius, .5rem); padding: .65rem .8rem; width: 100%; box-sizing: border-box;
  }
  .cf textarea { resize: vertical; min-height: 8rem; }
  .cf :is(select, textarea):focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .cf [aria-invalid='true'] { border-color: #e5484d; }
  .cf-foot { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .cf-status { margin: 0; font-size: .9rem; }
  .cf-status.is-ok { color: var(--accent); }
  .cf-status.is-err { color: #e5484d; }
  .cf-status button { font: inherit; color: inherit; background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
  .cf button[disabled] { opacity: .6; cursor: progress; }
</style>

<script>
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-contact-form]')) {
    const form = wrap.querySelector<HTMLFormElement>('form')!;
    const status = form.querySelector<HTMLElement>('.cf-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const text = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const say = (msg: string, kind: 'ok' | 'err' | '') => { status.textContent = msg; status.className = `cf-status ${kind ? `is-${kind}` : ''}`; };
    // Show the form once the game knows the visitor is signed in
    const whenReady = (tries = 0) => {
      const acc = (window as any).game?.account;
      if (!acc?.ready) { if (tries < 40) setTimeout(() => whenReady(tries + 1), 250); return; }
      if (acc.user) {
        wrap.setAttribute('data-signed-in', '');
        wrap.querySelector('[data-cf-who]')!.textContent = acc.user.email ? `${acc.user.name || acc.user.email} (${acc.user.email})` : acc.user.name;
      }
    };
    whenReady();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = text.value.trim();
      text.setAttribute('aria-invalid', String(!body));
      if (!body) { say('Write a message first.', 'err'); text.focus(); return; }
      button.disabled = true; say('Sending…', '');
      try {
        const res = await fetch(`${wrap.dataset.api}/messages`, {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body, topic: new FormData(form).get('topic'), page: location.pathname }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'Could not send right now.');
        text.value = '';
        say('Sent! My reply will show up in the message bubble. ', 'ok');
        const open = Object.assign(document.createElement('button'), { type: 'button', textContent: 'Open messages' });
        open.addEventListener('click', () => dispatchEvent(new CustomEvent('open-messages')));
        status.append(open);
        dispatchEvent(new CustomEvent('contact-sent'));
      } catch (err) {
        say((err as Error).message, 'err');
      }
      button.disabled = false;
    });
  }
</script>
