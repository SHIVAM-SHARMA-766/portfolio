---
// The site mark: a bold "S" with an accent dot ("S."). Colours come from CSS
// variables so each theme and palette can recolour it:
//   --logo-bg (tile), --logo-fg (S), --logo-dot (dot).
interface Props { size?: number; class?: string; label?: string }
const { size = 32, class: cls = '', label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
<svg class={`logo ${cls}`} viewBox="0 0 32 32" width={size} height={size} {...a11y}>
  <rect class="logo-bg" width="32" height="32" rx="9" />
  <path class="logo-s" d="M20.6 10.4c-.9-1.6-2.6-2.4-4.9-2.4-2.9 0-4.8 1.5-4.8 3.6 0 5 10.2 2.5 10.2 7.9 0 2.3-2.1 4-5.2 4-2.6 0-4.5-1-5.5-2.8" fill="none" stroke-width="3.2" stroke-linecap="round" />
  <circle class="logo-dot" cx="24.6" cy="23.6" r="2.1" />
</svg>

<style is:global>
  .logo { display: block; flex: none; }
  .logo .logo-bg { fill: var(--logo-bg, #18181b); }
  .logo .logo-s { stroke: var(--logo-fg, #ffffff); }
  .logo .logo-dot { fill: var(--logo-dot, #f97316); }
</style>
