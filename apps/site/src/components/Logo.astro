---
// The site mark: a shell prompt, an "S" and a cursor (">S_"). Colours come
// from CSS variables so every theme and palette recolours it:
//   --logo-bg (badge), --logo-a (prompt), --logo-b (S), --logo-c (cursor).
// `pixel` draws the same mark on a 12×12 grid for the Quest theme.
interface Props { pixel?: boolean; size?: number; class?: string; label?: string }
const { pixel = false, size = 32, class: cls = '', label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };

// Pixel cells: [x, y, width] runs on the 12×12 grid
const prompt = [[1, 3, 1], [2, 4, 1], [3, 5, 1], [2, 6, 1], [1, 7, 1]];
const ess = [[6, 2, 4], [5, 3, 1], [5, 4, 1], [6, 5, 3], [9, 6, 1], [9, 7, 1], [5, 8, 4]];
---
{pixel ? (
  <svg class={`logo logo--pixel ${cls}`} viewBox="0 0 12 12" width={size} height={size} shape-rendering="crispEdges" {...a11y}>
    <path class="logo-bg" d="M1 0h10v1h1v10h-1v1H1v-1H0V1h1z" />
    <g class="logo-a">{prompt.map(([x, y, w]) => <rect x={x} y={y} width={w} height="1" />)}</g>
    <g class="logo-b">{ess.map(([x, y, w]) => <rect x={x} y={y} width={w} height="1" />)}</g>
    <rect class="logo-c logo-cursor" x="1" y="10" width="10" height="1" />
  </svg>
) : (
  <svg class={`logo ${cls}`} viewBox="0 0 32 32" width={size} height={size} {...a11y}>
    <rect class="logo-bg" width="32" height="32" rx="8" />
    <path class="logo-a" d="M7.5 10l5 4-5 4" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path class="logo-b" d="M25 9.6c-.8-1.4-2.2-2.1-4-2.1-2.3 0-3.9 1.3-3.9 3.1 0 4 7.9 2 7.9 6.2 0 1.9-1.7 3.1-4.1 3.1-2 0-3.5-.8-4.3-2.2" fill="none" stroke-width="2.6" stroke-linecap="round" />
    <path class="logo-c logo-cursor" d="M8 24.5h16" stroke-width="2.6" stroke-linecap="round" />
  </svg>
)}

<style is:global>
  .logo { display: block; flex: none; }
  .logo .logo-bg { fill: var(--logo-bg, #16161d); }
  .logo:not(.logo--pixel) .logo-a { stroke: var(--logo-a, #2dd4bf); }
  .logo:not(.logo--pixel) .logo-b { stroke: var(--logo-b, #ff7a3d); }
  .logo:not(.logo--pixel) .logo-c { stroke: var(--logo-c, #ff7a3d); }
  .logo--pixel .logo-a { fill: var(--logo-a, #2dd4bf); }
  .logo--pixel .logo-b { fill: var(--logo-b, #ff7a3d); }
  .logo--pixel .logo-c { fill: var(--logo-c, #ff7a3d); }
  .logo-blink .logo-cursor { animation: logo-blink 1.1s steps(1) infinite; }
  @keyframes logo-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .logo-blink .logo-cursor { animation: none; } }
</style>
