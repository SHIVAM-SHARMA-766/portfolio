---
// The message bubble on every page: a short note to me. Signed-in visitors get
// a conversation and read my replies here (with an unread badge); others send
// a note with their email, and see replies once they sign in with that email.
// Messages land in the admin's Inbox. Hidden when there is no API (preview).
import { site } from '../lib/content';
const api = site.apiUrl?.replace(/\/$/, '');
const first = site.name.split(' ')[0];
---
{api && (
  <div class="mb" data-mb data-api={api} data-name={first}>
    <button type="button" class="mb-fab" aria-expanded="false" aria-controls="mb-panel" aria-label={`Message ${first}`}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z" /></svg>
      <span class="mb-badge" hidden></span>
    </button>
    <section class="mb-panel" id="mb-panel" role="dialog" aria-label={`Message ${first}`} hidden>
      <header class="mb-head">
        <div><b>Message {first}</b><small class="mb-sub">Usually replies within a day</small></div>
        <button type="button" class="mb-close" aria-label="Close">×</button>
      </header>
      <ol class="mb-thread" aria-live="polite"></ol>
      <form class="mb-form" novalidate>
        <p class="mb-intro">A short note, a question, or just hi. I read every message.</p>
        <textarea name="message" rows="3" maxlength="2000" placeholder="Write a message…" aria-label="Message" required></textarea>
        <input name="email" type="email" autocomplete="email" placeholder="Your email, so I can reply" aria-label="Your email" maxlength="200" />
        <label class="mb-hp" aria-hidden="true">Leave empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <div class="mb-foot">
          <button type="button" class="mb-signin" data-open-login>Sign in to see replies here</button>
          <button type="submit" class="mb-send">Send</button>
        </div>
        <p class="mb-status" role="status"></p>
      </form>
    </section>
  </div>
)}

<style>
  .mb { position: fixed; left: 16px; bottom: 16px; z-index: 840; font-size: .92rem; }
  :global(.g-has-bar) .mb { bottom: 84px; }
  .mb-fab { position: relative; width: 52px; height: 52px; display: grid; place-items: center; border-radius: var(--g-radius, 999px); border: 1px solid var(--border); background: var(--accent); color: var(--bg); cursor: pointer; box-shadow: 0 6px 20px rgb(0 0 0 / .18); transition: transform .15s; }
  .mb-fab:hover { transform: translateY(-2px); }
  .mb-fab:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .mb-badge { position: absolute; top: -4px; right: -4px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 99px; background: #e5484d; color: #fff; font: 700 12px/20px system-ui, sans-serif; text-align: center; }
  .mb-panel { position: absolute; left: 0; bottom: 64px; width: min(380px, calc(100vw - 32px)); max-height: min(560px, 75vh); display: flex; flex-direction: column; background: var(--surface, var(--bg)); color: var(--fg); border: 1px solid var(--border); border-radius: var(--g-radius, 14px); box-shadow: 0 18px 50px rgb(0 0 0 / .25); overflow: hidden; }
  .mb-panel[hidden] { display: none; }
  .mb-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .8rem 1rem; border-bottom: 1px solid var(--border); }
  .mb-head b { display: block; }
  .mb-sub { color: var(--muted); font-size: .78rem; }
  .mb-close { background: none; border: 0; color: var(--muted); font-size: 1.5rem; line-height: 1; cursor: pointer; padding: 0 .25rem; }
  .mb-thread { list-style: none; margin: 0; padding: .8rem 1rem; display: flex; flex-direction: column; gap: .5rem; overflow-y: auto; flex: 1; min-height: 0; }
  .mb-thread:empty { display: none; }
  .mb-thread :global(.mb-msg) { max-width: 85%; padding: .5rem .7rem; border-radius: var(--g-radius, 12px); white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.45; }
  .mb-thread :global(.mb-msg small) { display: block; margin-top: .2rem; font-size: .7rem; opacity: .7; }
  .mb-thread :global(.mb-msg--me) { align-self: flex-end; background: var(--accent); color: var(--bg); }
  .mb-thread :global(.mb-msg--them) { align-self: flex-start; background: color-mix(in srgb, var(--fg) 8%, transparent); }
  .mb-form { display: grid; gap: .5rem; padding: .8rem 1rem 1rem; border-top: 1px solid var(--border); }
  .mb-intro { margin: 0; color: var(--muted); font-size: .85rem; }
  .mb-form textarea, .mb-form input { font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--border); border-radius: var(--g-radius, 8px); padding: .55rem .7rem; width: 100%; box-sizing: border-box; resize: vertical; }
  .mb-form :is(textarea, input):focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .mb-form [aria-invalid='true'] { border-color: #e5484d; }
  .mb-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .mb-foot { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
  .mb-signin { background: none; border: 0; padding: 0; color: var(--accent); font: inherit; font-size: .8rem; text-decoration: underline; cursor: pointer; }
  .mb-send { font: inherit; font-weight: 600; padding: .5rem 1.1rem; border-radius: var(--g-radius, 99px); border: 0; background: var(--accent); color: var(--bg); cursor: pointer; margin-left: auto; }
  .mb-send[disabled] { opacity: .6; cursor: progress; }
  .mb-status { margin: 0; font-size: .82rem; min-height: 0; }
  .mb-status:empty { display: none; }
  .mb-status.is-ok { color: var(--accent); }
  .mb-status.is-err { color: #e5484d; }
  .mb[data-signed-in] .mb-intro, .mb[data-signed-in] [name=email], .mb[data-signed-in] .mb-signin { display: none; }
  @media (max-width: 600px) { .mb { left: 12px; bottom: 12px; } .mb-fab { width: 46px; height: 46px; } .mb-panel { bottom: 56px; width: calc(100vw - 24px); } }
  @media (prefers-reduced-motion: reduce) { .mb-fab { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mb]');
  if (root && window.top === window) {
    const api = root.dataset.api!;
    const fab = root.querySelector<HTMLButtonElement>('.mb-fab')!;
    const panel = root.querySelector<HTMLElement>('.mb-panel')!;
    const badge = root.querySelector<HTMLElement>('.mb-badge')!;
    const thread = root.querySelector<HTMLOListElement>('.mb-thread')!;
    const form = root.querySelector<HTMLFormElement>('.mb-form')!;
    const text = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const email = form.querySelector<HTMLInputElement>('[name=email]')!;
    const status = form.querySelector<HTMLElement>('.mb-status')!;
    const send = form.querySelector<HTMLButtonElement>('.mb-send')!;
    const shown = Date.now();
    let signedIn = false;
    let poll: number | undefined;
    let seq = 0; // only the newest load may update the thread and badge

    const say = (msg: string, kind: '' | 'ok' | 'err' = '') => { status.textContent = msg; status.className = `mb-status ${kind ? `is-${kind}` : ''}`; };
    const setBadge = (n: number) => { badge.hidden = !n; badge.textContent = String(n); fab.setAttribute('aria-label', `Message ${root.dataset.name}${n ? ` (${n} new repl${n > 1 ? 'ies' : 'y'})` : ''}`); };
    const call = async (path: string, init: RequestInit = {}) => {
      const res = await fetch(`${api}${path}`, { credentials: 'include', headers: { 'Content-Type': 'application/json' }, ...init });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || 'Could not send right now.');
      return body;
    };
    const when = (t: number) => new Date(t * 1000).toLocaleString(undefined, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    type Msg = { body: string; fromAdmin?: boolean; createdAt: number };
    const render = (list: Msg[]) => {
      thread.replaceChildren(...list.map((m) => {
        const li = document.createElement('li');
        li.className = `mb-msg ${m.fromAdmin ? 'mb-msg--them' : 'mb-msg--me'}`;
        li.textContent = m.body; // never HTML
        const s = document.createElement('small');
        s.textContent = `${m.fromAdmin ? root.dataset.name + ' · ' : ''}${when(m.createdAt)}`;
        li.append(s);
        return li;
      }));
      thread.scrollTop = thread.scrollHeight;
    };
    const load = async (markSeen: boolean) => {
      const mine = ++seq;
      try {
        const d = await call('/messages');
        if (mine !== seq) return; // a newer load (e.g. opening the panel) already answered
        signedIn = !!d.signedIn;
        root.toggleAttribute('data-signed-in', signedIn);
        if (!signedIn) return;
        render(d.messages ?? []);
        setBadge(markSeen || !panel.hidden ? 0 : d.unseen ?? 0);
        if (markSeen && d.unseen) call('/messages/seen', { method: 'POST' }).catch(() => {});
      } catch { /* offline: the form still works */ }
    };
    const open = (on: boolean) => {
      panel.hidden = !on;
      fab.setAttribute('aria-expanded', String(on));
      clearInterval(poll);
      if (on) {
        setBadge(0); // opening the bubble shows the replies, so they're seen now
        load(true);
        poll = window.setInterval(() => signedIn && load(true), 20000);
        setTimeout(() => text.focus(), 50);
      }
    };
    fab.addEventListener('click', () => open(panel.hidden));
    root.querySelector('.mb-close')!.addEventListener('click', () => { open(false); fab.focus(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { open(false); fab.focus(); } });
    text.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) form.requestSubmit(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = text.value.trim();
      const mail = email.value.trim();
      const bad = !body ? text : !signedIn && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail) ? email : null;
      text.setAttribute('aria-invalid', String(bad === text));
      email.setAttribute('aria-invalid', String(bad === email));
      if (bad) { say(bad === text ? 'Write a message first.' : 'Add your email so I can reply.', 'err'); bad.focus(); return; }
      send.disabled = true; say('Sending…');
      try {
        if (signedIn) {
          await call('/messages', { method: 'POST', body: JSON.stringify({ body, page: location.pathname }) });
          text.value = ''; say('');
          await load(true);
        } else {
          const hp = form.querySelector<HTMLInputElement>('[name=website]')!.value;
          await call('/contact', { method: 'POST', body: JSON.stringify({ email: mail, topic: 'quick', message: body, page: location.pathname, website: hp, elapsed: Date.now() - shown }) });
          text.value = '';
          say('Sent, thank you! I’ll reply by email, or sign in with that email to see my reply here.', 'ok');
        }
        dispatchEvent(new CustomEvent('contact-sent'));
      } catch (err) {
        say((err as Error).message, 'err');
      }
      send.disabled = false;
    });

    // Once the game knows whether the visitor is signed in, show any new replies.
    const whenReady = (fn: () => void, tries = 0) => {
      const acc = (window as any).game?.account;
      if (acc?.ready) fn();
      else if (tries < 40) setTimeout(() => whenReady(fn, tries + 1), 250);
    };
    whenReady(() => { if ((window as any).game.account.user) load(false); });
  }
</script>
