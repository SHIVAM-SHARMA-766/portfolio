---
// Live count, coins and the sign-in / account button. Each theme styles .acct*.
---
<div class="acct">
  <span class="g-live" data-live data-offline>…</span>
  <button type="button" class="acct-coins g-only" data-open-shop title="Coins — open the shop">🪙 <b data-game-coins>0</b></button>
  <button type="button" class="acct-login" data-open-login data-account-guest>Sign in</button>
  <button type="button" class="acct-user" data-open-login data-account-user hidden><img data-account-avatar alt="" width="24" height="24" hidden /><span class="acct-initial" data-account-initial aria-hidden="true"></span></button>
</div>
