---
// Theme and palette switcher. Markup is shared; each theme styles .sw-*.
import { palettesFor } from '@portfolio/tokens';
import { THEMES, themeUrl, shopItem } from '../lib/content';
interface Props { theme: string; slug: string; path?: string }
const { theme, slug, path } = Astro.props;
const palettes = palettesFor(theme);
const target = (t: string) => themeUrl(t);
---
<div class="sw">
  <div class="sw-group" role="group" aria-label="Theme">
    <span class="sw-label">Theme</span>
    <div class="sw-items">
      {THEMES.map((t) => (
        <a class="sw-theme" href={target(t.id)} aria-current={t.id === theme ? 'true' : undefined} title={t.blurb}
          data-shop-item={shopItem(`theme:${t.id}`) ? `theme:${t.id}` : undefined}>{t.label}<span class="sw-price" data-price></span></a>
      ))}
    </div>
  </div>
  <div class="sw-group" role="group" aria-label="Colour palette">
    <span class="sw-label">Palette</span>
    <div class="sw-items">
      {palettes.map((p) => (
        <button type="button" class="sw-palette" data-palette-btn={p.id}
          data-shop-item={shopItem(`palette:${theme}-${p.id}`) ? `palette:${theme}-${p.id}` : undefined}
          title={shopItem(`palette:${theme}-${p.id}`) ? `${p.label} — ${shopItem(`palette:${theme}-${p.id}`)!.price} coins` : p.label}
          style={`--sw-bg:${p.colors.bg};--sw-accent:${p.colors.accent}`}>
          <span class="sw-swatch" aria-hidden="true"></span>
          <span class="sw-name">{p.label}</span>
          <span class="sw-price" data-price></span>
        </button>
      ))}
    </div>
  </div>
</div>
