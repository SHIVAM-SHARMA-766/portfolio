---
// Shared <head>: meta, palette tokens, pre-paint preferences, game config.
import { paletteCss, palettesFor } from '@portfolio/tokens';
import { site, gameConfig, pageUrl, PREVIEW } from '../lib/content';
import '@portfolio/game/game.css';
import Analytics from './Analytics.astro';
import { seoFor, ldJson } from '../lib/seo';
import { ogVariant } from '../lib/images';
import missionsRaw from '../../../../content/missions.json';
const sourceFlag = missionsRaw.missions.find((m) => m.kind === 'page-source')?.flag;

interface Props {
  theme: string;
  title: string;
  description?: string;
  slug: string;
  pageIdent: string | null;
  fonts?: string;
  image?: string | null;
}
const { theme, title, description = site.description, slug, pageIdent, fonts, image } = Astro.props;
const fullTitle = slug === '' && title === 'Home' ? `${site.name} — ${site.role}` : `${title} · ${site.name}`;
const canonical = new URL(pageUrl(site.defaultTheme, slug), site.siteUrl).href;
const palettes = palettesFor(theme).map((p) => p.id);
const defaultPalette = site.defaultPalettes[theme] ?? palettes[0];
// A first visit follows the system's dark mode where the theme has a dark palette
const darkPalette = palettes.includes('dark') ? 'dark' : null;
const config = { ...(await gameConfig(pageIdent)), theme };
const seo = await seoFor(slug, title, description, image ?? null, canonical);
// Share cards: the page's own image (project cover, banner, post cover), else the branded card
const ogImage = new URL(image ? ogVariant(image) : '/images/og-default.jpg', site.siteUrl).href;
const isProfile = slug === '' || slug === 'about';
const [firstName, ...rest] = site.name.split(' ');
---
<head>
  {sourceFlag && <Fragment set:html={`<!-- psst. you found the source. ${sourceFlag} — submit it in the terminal. -->`} />}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
  {PREVIEW && <script is:inline>
    addEventListener('DOMContentLoaded', function () {
      var r = document.createElement('div');
      r.textContent = 'Draft preview · not public';
      r.setAttribute('role', 'note');
      r.style.cssText = 'position:fixed;left:50%;bottom:12px;transform:translateX(-50%);z-index:2147483647;background:#b45309;color:#fff;font:600 13px/1 system-ui,sans-serif;padding:8px 14px;border-radius:99px;box-shadow:0 4px 14px rgb(0 0 0/.25);pointer-events:none';
      document.body.appendChild(r);
    });
  </script>}
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={seo.article ? 'article' : isProfile ? 'profile' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
  <meta property="og:image:alt" content={image ? title : `${site.name} — ${site.role}`} />
  {isProfile && <><meta property="profile:first_name" content={firstName} /><meta property="profile:last_name" content={rest.join(' ')} /></>}
  {seo.article && <meta property="article:published_time" content={seo.article.published} />}
  {seo.article?.tags.map((t) => <meta property="article:tag" content={t} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {seo.ld.map((x) => <script type="application/ld+json" set:html={ldJson(x)} />)}
  <meta name="theme-color" content="#111111" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  {site.resume && <meta name="pf-cv" content={site.resume} />}
  <Analytics />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
  {fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
  {fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
  {fonts && <link rel="stylesheet" href={fonts} />}
  <style set:html={paletteCss(theme)}></style>
  <script is:inline define:vars={{ theme, palettes, defaultPalette, darkPalette }}>
    // Runs before paint so the saved palette never flashes.
    (function () {
      var pal = defaultPalette, root = document.documentElement;
      try {
        var p = JSON.parse(localStorage.getItem('pf.prefs.v1')) || {};
        var saved = (p.palettes || {})[theme];
        if (saved && palettes.indexOf(saved) !== -1) pal = saved;
        else if (darkPalette && matchMedia('(prefers-color-scheme: dark)').matches) pal = darkPalette;
        p.theme = theme;
        localStorage.setItem('pf.prefs.v1', JSON.stringify(p));
      } catch (e) {}
      root.dataset.palette = pal;
    })();
  </script>
  <script type="application/json" id="game-config" set:html={JSON.stringify(config)}></script>
</head>
