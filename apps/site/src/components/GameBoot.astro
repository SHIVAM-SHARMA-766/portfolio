---
// Boots the game engine and wires the switcher and achievements dialog.
---
<script>
  import { mountGame } from '@portfolio/game';

  const root = document.documentElement;
  const theme = root.dataset.theme!;
  const game = mountGame();

  if (game) game.award(`theme:${theme}`, game.rewards.theme ?? 10, { label: 'New theme discovered' });

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-ach]')) {
      (document.getElementById('ach-dialog') as HTMLDialogElement | null)?.showModal();
    }
  });

  // Contact links count towards "Say hello"
  document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((a) => {
    a.dataset.xp ??= String(window.game?.rewards.contactEmail ?? 10);
    a.dataset.xpId ??= 'contact:email';
    a.dataset.xpLabel ??= 'Saying hello';
  });
</script>
