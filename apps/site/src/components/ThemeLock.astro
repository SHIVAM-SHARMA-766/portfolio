---
// A theme the visitor hasn't unlocked: a free preview (a few minutes, never
// interrupting a page), then an unlock screen on the next page. The page itself stays in the HTML for search engines and
// no-JS visitors; the game layer decides what to show.
import { shopItem, site, themeUrl } from '../lib/content';
interface Props { item: string; slug: string }
const { item, slug } = Astro.props;
const it = shopItem(item);
---
{it && it.price > 0 && (
  <>
    <div class="g-preview-bar" data-preview-bar={item} hidden role="status">
      <span>👀 Previewing <b>{it.label}</b></span>
      <span class="g-preview-bar__actions">
        <span data-buy-slot={item}></span>
        <a class="g-btn g-btn--ghost" href={themeUrl(site.defaultTheme)}>Exit preview</a>
      </span>
    </div>
    <div class="g-theme-lock" data-theme-lock={item} hidden role="dialog" aria-modal="true" aria-labelledby="lock-title">
      <div class="g-theme-lock__box">
        <p class="g-theme-lock__kicker">Preview over</p>
        <h2 id="lock-title">{it.label}</h2>
        <p>{it.description}</p>
        <p class="g-theme-lock__coins">You have <b>🪙 <span data-game-coins>0</span></b> · it costs <b>🪙 {it.price}</b></p>
        <div class="g-theme-lock__actions">
          <span data-buy-slot={item}></span>
          <a class="g-btn g-btn--ghost" href={themeUrl(site.defaultTheme)}>Back to {site.defaultTheme.charAt(0).toUpperCase() + site.defaultTheme.slice(1)} (free)</a>
        </div>
        <p class="g-muted g-theme-lock__hint">Earn coins by exploring the other themes: every XP point is a coin.</p>
      </div>
    </div>
  </>
)}
