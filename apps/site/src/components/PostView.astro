---
interface Props { theme: string; title: string; date: Date; tags: string[] }
const { theme, title, date, tags } = Astro.props;
const when = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<article class="post">
  <header class="post-head">
    <a class="post-back" href="/blog/">← All posts</a>
    <h1>{title}</h1>
    <p class="post-meta"><time datetime={date.toISOString()}>{when}</time>{tags.length > 0 && <> · {tags.map((t) => `#${t}`).join(' ')}</>}</p>
  </header>
  <div class="prose"><slot /></div>
</article>
