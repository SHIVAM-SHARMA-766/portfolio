---
interface Props { theme: string; title: string; date: Date; tags: string[]; cover?: string | null; coverAlt?: string | null }
import { srcsetFor } from '../lib/images';
const { theme, title, date, tags, cover, coverAlt } = Astro.props;
const set = await srcsetFor(cover);
const when = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<article class="post">
  <header class="post-head">
    <a class="post-back" href="/blog/">← All posts</a>
    <h1>{title}</h1>
    <p class="post-meta"><time datetime={date.toISOString()}>{when}</time>{tags.length > 0 && <> · {tags.map((t) => `#${t}`).join(' ')}</>}</p>
  </header>
  {cover && <img class="post-cover" src={cover} srcset={set} sizes="(max-width: 900px) 100vw, 860px" alt={coverAlt ?? ''} width="1600" height="840" fetchpriority="high" />}
  <div class="prose"><slot /></div>
</article>
