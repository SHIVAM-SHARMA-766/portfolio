---
// Renders one content page inside whichever layout the route passes in.
// Generated detail pages (projects, experience) have no page id of their own:
// their XP comes from opening them (the card link), not from visiting.
import { getNav, pageId } from '../lib/content';
import type { Page } from '../lib/schema';
import BlockRenderer from './BlockRenderer.astro';
interface Props { page: Page; theme: string; Layout: any; current?: string; detail?: boolean }
const { page, theme, Layout, current = page.slug, detail = false } = Astro.props;
const nav = await getNav();
---
<Layout theme={theme} title={page.title} description={page.description} slug={page.slug} current={current} nav={nav} pageIdent={detail ? null : pageId(page.slug)}>
  <BlockRenderer blocks={page.blocks} theme={theme} />
</Layout>
