---
// One 404 for every theme (Caddy serves this file for any missing path), so
// it is neutral: light or dark by system setting, with the site mark and a way
// back to every page.
import { site, getNav, pageUrl } from '../lib/content';
import Logo from '../components/Logo.astro';
const nav = (await getNav()).filter((p) => p.slug !== '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · {site.name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root { --bg: #fafaf7; --surface: #fff; --fg: #18181b; --muted: #5c5c66; --accent: #c2410c; --border: #e4e4de; color-scheme: light dark; }
      @media (prefers-color-scheme: dark) { :root { --bg: #111113; --surface: #18181b; --fg: #f4f4f5; --muted: #a1a1aa; --accent: #fb923c; --border: #2a2a2e; } }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; background: var(--bg); color: var(--fg); font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { width: min(480px, 100%); }
      .logo { --logo-bg: var(--fg); --logo-fg: var(--bg); --logo-dot: var(--accent); margin-bottom: 1.6rem; }
      code { display: block; font: .85rem/1.5 ui-monospace, monospace; color: var(--muted); margin-bottom: .6rem; overflow-wrap: anywhere; }
      h1 { font-size: clamp(1.8rem, 6vw, 2.4rem); line-height: 1.15; margin: 0 0 .6rem; letter-spacing: -.02em; }
      p { color: var(--muted); margin: 0 0 1.6rem; }
      .home { display: inline-block; background: var(--fg); color: var(--bg); text-decoration: none; padding: .7rem 1.2rem; border-radius: 999px; font-weight: 600; }
      ul { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; border-top: 1px solid var(--border); padding-top: 1.2rem; }
      ul a { display: inline-block; color: var(--fg); text-decoration: none; padding: .35rem .8rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); font-size: .9rem; }
      a:hover { border-color: var(--accent); }
      .home:hover { opacity: .9; }
    </style>
  </head>
  <body>
    <main>
      <a href="/" aria-label={`${site.name} — home`}><Logo size={44} /></a>
      <code id="path">$ cd ??? — no such page (404)</code>
      <h1>This page doesn't exist</h1>
      <p>The link may be old or mistyped. Everything is still here:</p>
      <a class="home" href={pageUrl(site.defaultTheme, '')}>Go to the home page</a>
      <ul>
        {nav.map((p) => <li><a href={pageUrl(site.defaultTheme, p.slug)}>{p.navLabel ?? p.title}</a></li>)}
        {site.learnUrl && <li><a href={site.learnUrl}>Learn ↗</a></li>}
      </ul>
    </main>
    <script is:inline>
      document.getElementById('path').textContent = '$ cd ' + location.pathname + ' — no such page (404)';
    </script>
  </body>
</html>
