---
// Entry point: send visitors to the theme they used last, or the default.
import { site, pageUrl, THEMES } from '../lib/content';
const fallback = pageUrl(site.defaultTheme, '');
const themes = THEMES.map((t) => t.id);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{site.name} — {site.role}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={new URL(fallback, site.siteUrl).href} />
    <script is:inline define:vars={{ fallback, themes }}>
      var t;
      try { t = (JSON.parse(localStorage.getItem('pf.prefs.v1')) || {}).theme; } catch (e) {}
      location.replace(themes.indexOf(t) !== -1 ? '/' + t + '/' : fallback);
    </script>
    <meta http-equiv="refresh" content={`1; url=${fallback}`} />
  </head>
  <body style="background:#0b0b0b;color:#ddd;font-family:system-ui;display:grid;place-items:center;min-height:100vh">
    <p><a href={fallback} style="color:#7dd3fc">Enter {site.name}'s portfolio →</a></p>
  </body>
</html>
