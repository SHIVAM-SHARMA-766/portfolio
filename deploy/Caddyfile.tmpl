# Generated by deploy/setup-server.sh from content/site.json — edit the template, not the copy on the server.
{
	# Let's Encrypt expiry notices; the address is not published anywhere.
	email __ACME_EMAIL__
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

(static) {
	file_server
	# Hashed build assets never change; everything else revalidates.
	@immutable path /_astro/* /pagefind/* /admin/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path *.html */
	header @html Cache-Control "public, max-age=0, must-revalidate"
}

(notfound) {
	handle_errors {
		root * {args[0]}
		rewrite * /404.html
		file_server
	}
}

__SITE_HOST__ {
	import common
	import notfound /srv/portfolio/site

	# The API (Go service on localhost): sign-in, progress, shop, live presence, admin.
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	# The admin panel: a single-page app in /srv/portfolio/admin.
	handle /admin* {
		root * /srv/portfolio
		try_files {path} /admin/index.html
		file_server
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'"
		header Cache-Control "no-store"
		@assets path /admin/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	# Clean URLs: the theme lives in the pf_theme cookie, not the URL. Each theme's
	# build sits in /srv/portfolio/site/<theme>/ and is served under the plain path.
	# Mirrored for dev and tests in scripts/theme-routing.mjs.
	handle {
		root * /srv/portfolio/site
		route {
			# ?theme=<name> picks a theme, remembers it, and returns to the clean URL
			@pick query theme=terminal theme=quest theme=studio
			header @pick Set-Cookie "pf_theme={query.theme}; Path=/; Max-Age=31536000; SameSite=Lax; Secure"
			redir @pick {path} 302
			# Old /<theme>/... links keep working
			@legacy path_regexp legacy ^/(terminal|quest|studio)(/.*)$
			header @legacy Set-Cookie "pf_theme={re.legacy.1}; Path=/; Max-Age=31536000; SameSite=Lax; Secure"
			redir @legacy {re.legacy.2} 301
			@legacyBare path /terminal /quest /studio
			redir @legacyBare {path}/ 301
			# Serve the visitor's theme; Studio unless they picked another
			@quest {
				not path /_astro/* /pagefind/* /uploads/* /images/* /favicon.svg /rss.xml /404.html /robots.txt /sitemap*
				header_regexp Cookie (?:^|;\s*)pf_theme=quest(?:;|$)
			}
			@terminal {
				not path /_astro/* /pagefind/* /uploads/* /images/* /favicon.svg /rss.xml /404.html /robots.txt /sitemap*
				header_regexp Cookie (?:^|;\s*)pf_theme=terminal(?:;|$)
			}
			@studio {
				not path /_astro/* /pagefind/* /uploads/* /images/* /favicon.svg /rss.xml /404.html /robots.txt /sitemap*
				not header_regexp Cookie (?:^|;\s*)pf_theme=(?:quest|terminal)(?:;|$)
			}
			rewrite @quest /quest{uri}
			rewrite @terminal /terminal{uri}
			rewrite @studio /studio{uri}
		}
		header Vary Cookie
		import static
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' wss://__SITE_HOST__; frame-ancestors 'none'"
	}
}

__LEARN_HOST__ {
	import common
	import notfound /srv/portfolio/learn
	root * /srv/portfolio/learn
	import static
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://__SITE_HOST__ wss://__SITE_HOST__; frame-ancestors 'none'"
}

# Previous hostnames (content/site.json previousHosts) redirect here.
__REDIRECTS__
