{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev -w @portfolio/site",
    "dev:learn": "npm run dev -w @portfolio/learn",
    "build": "npm run build -w @portfolio/site && npm run build -w @portfolio/learn",
    "build:site": "npm run build -w @portfolio/site",
    "build:learn": "npm run build -w @portfolio/learn",
    "test": "node --test \"packages/game/test/*.test.js\"",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
