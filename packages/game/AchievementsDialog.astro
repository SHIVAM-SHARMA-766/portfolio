---
// Achievements and game settings. Themes style #ach-dialog.
---
<dialog id="ach-dialog" class="ach-dialog" aria-labelledby="ach-title">
  <div class="ach-head">
    <h2 id="ach-title">Achievements <span data-game-ach-count></span></h2>
    <form method="dialog"><button class="ach-close" aria-label="Close">✕</button></form>
  </div>
  <p class="ach-level">Level <b data-game-level>1</b> · <span data-game-level-name>Visitor</span> · <b data-game-xp>0</b> XP — <span data-game-next></span></p>
  <div class="ach-bar" data-game-progress role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100"><span></span></div>
  <ul class="ach-list" data-game-achievements></ul>
  <div class="ach-actions">
    <button type="button" data-game-sound aria-pressed="false">🔊 Sound</button>
    <button type="button" data-live-cursors aria-pressed="true"><span data-label>Hide cursors</span></button>
    <button type="button" data-open-shop>🪙 Shop</button>
    <button type="button" data-game-reset>Reset progress</button>
  </div>
</dialog>
